-- *******************************************************************
--  DatabaseSchema: Script for creating the database
--   Usage:
--       $ sqlite3 LTM.db < DatabaseSchema.sql
--
-- *******************************************************************

-- *******************************************************************
-- CLEAN
-- *******************************************************************
/*DROP TABLE Node;*/

-- *******************************************************************
-- CREATE
-- *******************************************************************
CREATE TABLE Node (
    lidar_geometry BLOB, -- immutable Gaussian node-local geometry
	id INTEGER NOT NULL,
	map_id INTEGER NOT NULL,
	weight INTEGER,
	stamp FLOAT,
	pose BLOB,                -- 3x4 float
	velocity BLOB,            -- 6 float (vx,vy,vz,vroll,vpitch,vyaw) m/s and rad/s
	label TEXT,
	time_enter DATE,
	PRIMARY KEY (id)
);

CREATE TABLE Link (
	from_id INTEGER NOT NULL,
	to_id INTEGER NOT NULL,
	type INTEGER NOT NULL,    -- kOdometry=0, kLoopClosure=1, kPosePrior=7, kGravity=9; retired IDs are rejected
	information_matrix BLOB NOT NULL, -- 6x6 double (inverse covariance)
	transform BLOB,           -- 3x4 float
	FOREIGN KEY (from_id) REFERENCES Node(id),
	FOREIGN KEY (to_id) REFERENCES Node(id)
);

PRAGMA user_version = 14;
CREATE TABLE WorkingMemory (node_id INTEGER PRIMARY KEY CHECK(node_id>0), FOREIGN KEY(node_id) REFERENCES Node(id));
CREATE TRIGGER working_memory_insert BEFORE INSERT ON WorkingMemory
WHEN NOT EXISTS (SELECT 1 FROM Node WHERE id=NEW.node_id)
BEGIN SELECT RAISE(ABORT, 'Working-memory node missing'); END;
CREATE TRIGGER working_memory_delete AFTER DELETE ON Node
BEGIN DELETE FROM WorkingMemory WHERE node_id=OLD.id; END;
CREATE TABLE Trajectory (sequence INTEGER PRIMARY KEY, anchor_id INTEGER NOT NULL, stamp REAL NOT NULL,
 anchor_from_body BLOB NOT NULL, odom_from_body BLOB NOT NULL);
CREATE INDEX IDX_Trajectory_anchor ON Trajectory(anchor_id,sequence);

CREATE TABLE NodeSequence (singleton INTEGER PRIMARY KEY CHECK(singleton=1), high_water INTEGER NOT NULL);
INSERT INTO NodeSequence VALUES(1,0);
CREATE TRIGGER node_sequence AFTER INSERT ON Node BEGIN
 UPDATE NodeSequence SET high_water=MAX(high_water,NEW.id) WHERE singleton=1;
END;
-- The writer commits pending anchor signatures before publishing an archive.



--

CREATE TABLE Info (
	STM_size INTEGER,
	last_sign_added INTEGER,
	process_mem_used INTEGER,
	database_mem_used INTEGER,
	parameters TEXT,
	time_enter DATE
);

CREATE TABLE Statistics (
	id INTEGER NOT NULL,
	stamp FLOAT,
	data BLOB,              -- compressed string
	wm_state BLOB,	        -- compressed data
	FOREIGN KEY (id) REFERENCES Node(id)
);

CREATE TABLE Admin (
	version TEXT,

	opt_ids BLOB,            -- Node ids associated with optimized poses
	opt_poses BLOB,          -- compressed N*3x4 float
	opt_last_localization BLOB, -- 3x4 float


	time_enter DATE
);

-- *******************************************************************
-- TRIGGERS
-- *******************************************************************


 --   Creating a trigger for time_enter
CREATE TRIGGER insert_Node_timeEnter AFTER INSERT ON Node
BEGIN
 UPDATE Node SET time_enter = DATETIME('NOW')  WHERE rowid = new.rowid;
END;

CREATE TRIGGER insert_Info_timeEnter AFTER INSERT ON Info
BEGIN
 UPDATE Info SET time_enter = DATETIME('NOW')  WHERE rowid = new.rowid;
END;

-- *******************************************************************
-- INDEXES
-- *******************************************************************
CREATE UNIQUE INDEX IDX_Node_id on Node (id);

CREATE INDEX IDX_Link_from_id on Link (from_id);
CREATE INDEX IDX_Link_to_id on Link (to_id);
CREATE UNIQUE INDEX IDX_node_label on Node (label);
CREATE UNIQUE INDEX IDX_Statistics_id on Statistics (id);

-- *******************************************************************
-- VERSION
-- *******************************************************************
INSERT INTO Admin(version) VALUES('0');
